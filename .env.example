# ---------------------------------------------------------------------------
# PandaDoc mode
#
# sandbox    = free, unlimited, NOT legally binding. Use for all testing.
# production = real documents, spends the 60-per-year allowance permanently.
#
# Defaults to sandbox when unset, so spending a real document is deliberate.
# ---------------------------------------------------------------------------
PANDADOC_MODE=sandbox

# Sandbox workspace (used when PANDADOC_MODE=sandbox)
PANDADOC_SANDBOX_API_KEY=
# Only needed if the sandbox workspace has its own copy of the template.
PANDADOC_SANDBOX_TEMPLATE_UUID=

# Production workspace (used when PANDADOC_MODE=production)
PANDADOC_API_KEY=
PANDADOC_TEMPLATE_UUID=

# Signs incoming webhooks. From Developer Dashboard > Webhooks.
PANDADOC_WEBHOOK_SHARED_KEY=

# Let PandaDoc email the tenant directly in addition to giving the landlord a
# link. false keeps every outbound message in the landlord's hands.
PANDADOC_SENDS_EMAIL=false

# Lifetime in seconds for the fallback session link, used only when a
# recipient's non-expiring shared_link is unavailable. Default 14 days.
PANDADOC_SESSION_LIFETIME=1209600

# ---------------------------------------------------------------------------
# Local storage
# ---------------------------------------------------------------------------
LGD_DB_PATH=leases.db
LGD_ARCHIVE_DIR=archive

# Section 2 on-time payment deduction, in dollars.
LGD_EARLY_PAYMENT_DISCOUNT=50

# ---------------------------------------------------------------------------
# Landlords and logins live in accounts.json, not here.
#   python -m app.accounts init
#   python -m app.accounts set-password kevin
# ---------------------------------------------------------------------------
