# ---------------------------------------------------------------------------
# PandaDoc mode
#
# sandbox    = free, unlimited, NOT legally binding. Use for all testing.
# production = real documents, spends the 60-per-year allowance permanently.
#
# Defaults to sandbox when unset, so spending a real document is deliberate.
# ---------------------------------------------------------------------------
PANDADOC_MODE=sandbox

# Sandbox workspace (used when PANDADOC_MODE=sandbox)
PANDADOC_SANDBOX_API_KEY=
# Only needed if the sandbox workspace has its own copy of the template.
PANDADOC_SANDBOX_TEMPLATE_UUID=

# Production workspace (used when PANDADOC_MODE=production)
PANDADOC_API_KEY=
PANDADOC_TEMPLATE_UUID=

# Signs incoming webhooks. From Developer Dashboard > Webhooks.
PANDADOC_WEBHOOK_SHARED_KEY=

# Let PandaDoc email the tenant directly in addition to giving the landlord a
# link. false keeps every outbound message in the landlord's hands.
PANDADOC_SENDS_EMAIL=false

# Lifetime in seconds for the fallback session link, used only when a
# recipient's non-expiring shared_link is unavailable. Default 14 days.
PANDADOC_SESSION_LIFETIME=1209600

# ---------------------------------------------------------------------------
# Local storage - what a plain laptop run uses, and all that tests need.
# Leave this whole section alone unless you're deploying somewhere that
# wipes local disk on restart (e.g. Render's free tier - see below).
# ---------------------------------------------------------------------------
LGD_DB_PATH=leases.db
LGD_ARCHIVE_DIR=archive

# Section 2 on-time payment deduction, in dollars.
LGD_EARLY_PAYMENT_DISCOUNT=50

# ---------------------------------------------------------------------------
# Landlords and logins live in accounts.json, not here.
#   python -m app.accounts init
#   python -m app.accounts set-password kevin
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Render + Supabase deployment (free tier, no credit card).
#
# Leave every line below blank to run entirely on local files, exactly as
# above - this is what tests do. Set them only when deploying somewhere
# (e.g. Render's free web service) whose local disk does not survive a
# restart:
#
#   DATABASE_URL   - a Supabase Postgres connection string. Replaces
#                    LGD_DB_PATH for leases, and also makes accounts.json
#                    switch to Postgres `landlords`/`users` tables (see
#                    `python -m app.accounts` for managing them there).
#   LGD_ARCHIVE_DIR - set to "supabase:<bucket-name>" to archive signed PDFs
#                    in a Supabase Storage bucket instead of local disk.
#                    Create the bucket yourself in the Supabase dashboard
#                    first; nothing here creates it.
#   SUPABASE_URL, SUPABASE_KEY - only needed when LGD_ARCHIVE_DIR above
#                    points at a supabase: bucket. Project Settings > API.
#                    Use the service_role key, not the anon key: the
#                    landlord dashboard is the only thing writing to the
#                    bucket, and it already enforces its own auth.
# ---------------------------------------------------------------------------
# DATABASE_URL=
# SUPABASE_URL=
# SUPABASE_KEY=
